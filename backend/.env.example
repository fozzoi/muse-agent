# 1. console.groq.com (Fast Router & Chat)
GROQ_API_KEY=gsk_your_groq_api_key

# 2. console.mistral.ai (Codestral Tool Maker)
MISTRAL_API_KEY=mstrl_your_mistral_api_key

# 3. aistudio.google.com (1M Context & Multimodal)
